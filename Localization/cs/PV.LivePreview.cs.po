msgid "Laptop (1366x768)"
msgstr "Laptop (1366x768)"

#: PV.LivePreview\Views\LivePreviewSettings_Edit.cshtml
msgctxt "PV.LivePreview.Views.LivePreviewSettings_Edit"
msgid "Desktop (1920x1080)"
msgstr "Desktop (1920x1080)"

#: PV.LivePreview\Views\LivePreviewSettings_Edit.cshtml
msgctxt "PV.LivePreview.Views.LivePreviewSettings_Edit"
msgid "Custom size (entered by the user)"
msgstr "Vlastní rozměr (zadává uživatel)"

#: PV.LivePreview\Views\LivePreviewSettings_Edit.cshtml
msgctxt "PV.LivePreview.Views.LivePreviewSettings_Edit"
msgid "Devices shown in the toolbar"
msgstr "Zařízení zobrazená v toolbaru"

#: PV.LivePreview\Views\LivePreviewSettings_Edit.cshtml
msgctxt "PV.LivePreview.Views.LivePreviewSettings_Edit"
msgid "Custom devices"
msgstr "Vlastní zařízení"

#: PV.LivePreview\Views\LivePreviewSettings_Edit.cshtml
msgctxt "PV.LivePreview.Views.LivePreviewSettings_Edit"
msgid "One device per line in the format \"Name; width x height\", for example \"Galaxy S20; 412x915\". Each device gets its own button in the toolbar and can be rotated."
msgstr "Jedno zařízení na řádek ve formátu \"Název; šířka x výška\", např. \"Galaxy S20; 412x915\". Každé zařízení dostane v toolbaru vlastní tlačítko a lze ho otočit."

#: PV.LivePreview\Views\LivePreviewSettings_Edit.cshtml
msgctxt "PV.LivePreview.Views.LivePreviewSettings_Edit"
msgid "Default device"
msgstr "Výchozí zařízení"

#: PV.LivePreview\Views\LivePreviewSettings_Edit.cshtml
msgctxt "PV.LivePreview.Views.LivePreviewSettings_Edit"
msgid "Laptop (default)"
msgstr "Laptop (výchozí)"

#: PV.LivePreview\Views\LivePreviewSettings_Edit.cshtml
msgctxt "PV.LivePreview.Views.LivePreviewSettings_Edit"
msgid "Used when the user has not chosen a device for this content type yet. Newly added custom devices appear here after saving. If the default device is not shown in the toolbar, the first shown device is used."
msgstr "Použije se, pokud si uživatel pro tento typ obsahu ještě nezvolil zařízení. Nově přidaná vlastní zařízení se zde objeví po uložení. Pokud výchozí zařízení není zobrazené v toolbaru, použije se první zobrazené."

#: PV.LivePreview\Views\LivePreviewSettings_Edit.cshtml
msgctxt "PV.LivePreview.Views.LivePreviewSettings_Edit"
msgid "Update delay (ms)"
msgstr "Zpoždění aktualizace (ms)"

#: PV.LivePreview\Views\LivePreviewSettings_Edit.cshtml
msgctxt "PV.LivePreview.Views.LivePreviewSettings_Edit"
msgid "How long to wait after the last change in the form before the preview is refreshed. A longer delay reduces the load on the server for demanding pages."
msgstr "Jak dlouho po poslední změně ve formuláři počkat, než se náhled obnoví. Delší zpoždění snižuje zátěž serveru u náročných stránek."

#: PV.LivePreview\Views\LivePreviewSettings_Edit.cshtml
msgctxt "PV.LivePreview.Views.LivePreviewSettings_Edit"
msgid "Hidden when the editor is opened"
msgstr "Při otevření editace skrytý"

#: PV.LivePreview\Views\LivePreviewSettings_Edit.cshtml
msgctxt "PV.LivePreview.Views.LivePreviewSettings_Edit"
msgid "The preview is rendered only after the user shows it. Suitable for content types whose rendering is demanding."
msgstr "Náhled se vykreslí, až ho uživatel zobrazí. Vhodné pro typy obsahu s náročným vykreslením."

#: PV.LivePreview\Views\LivePreviewInjection.cshtml
msgctxt "PV.LivePreview.Views.LivePreviewInjection"
msgid "Devices with a name – custom devices defined for this content type by the administrator."
msgstr "Zařízení s názvem – vlastní zařízení, která pro tento typ obsahu nastavil správce."

# Volba display typu (bod 7 roadmapy)
#: PV.LivePreview\Controllers\LivePreviewController.cs
msgctxt "PV.LivePreview.Controllers.LivePreviewController"
msgid "This display type is not allowed in the preview."
msgstr "Tento způsob zobrazení není v náhledu povolen."

#: PV.LivePreview\Views\LivePreviewInjection.cshtml
msgctxt "PV.LivePreview.Views.LivePreviewInjection"
msgid "Display type: Detail / Summary (how the item looks in a list)"
msgstr "Zobrazení: Detail / Souhrn (jak položka vypadá ve výpisu)"

#: PV.LivePreview\Views\LivePreviewInjection.cshtml
msgctxt "PV.LivePreview.Views.LivePreviewInjection"
msgid "Detail"
msgstr "Detail"

#: PV.LivePreview\Views\LivePreviewInjection.cshtml
msgctxt "PV.LivePreview.Views.LivePreviewInjection"
msgid "Summary"
msgstr "Souhrn"

#: PV.LivePreview\Views\LivePreviewInjection.cshtml
msgctxt "PV.LivePreview.Views.LivePreviewInjection"
msgid "Detail / Summary – switches between the detail page of the item and its summary, i.e. how the item looks in a list (for example an article card on a blog)."
msgstr "Detail / Souhrn – přepíná mezi stránkou detailu položky a jejím souhrnem, tedy jak položka vypadá ve výpisu (např. karta článku na blogu)."

#: PV.LivePreview\Views\LivePreviewInjection.cshtml
msgctxt "PV.LivePreview.Views.LivePreviewInjection"
msgid "Display type: Detail / Summary"
msgstr "Zobrazení: Detail / Souhrn"

# Náhled ve správném jazyce (bod 8 roadmapy)
#: PV.LivePreview\Views\LivePreviewInjection.cshtml
msgctxt "PV.LivePreview.Views.LivePreviewInjection"
msgid "Language (culture) in which the preview was rendered – the culture of the content item"
msgstr "Jazyk (kultura), ve kterém se náhled vykreslil – kultura položky obsahu"

#: PV.LivePreview\Views\LivePreviewInjection.cshtml
msgctxt "PV.LivePreview.Views.LivePreviewInjection"
msgid "Multilingual content is rendered in the language of the content item, so the theme texts match the language of the page. The language is shown in the bar with the globe icon."
msgstr "Vícejazyčný obsah se vykresluje v jazyce položky obsahu, takže texty tématu odpovídají jazyku stránky. Jazyk je v liště u ikony zeměkoule."

# Samostatné okno náhledu (bod 4 roadmapy)
#: PV.LivePreview\Views\LivePreviewInjection.cshtml
msgctxt "PV.LivePreview.Views.LivePreviewInjection"
msgid "Open in a separate window"
msgstr "Otevřít v samostatném okně"

#: PV.LivePreview\Views\LivePreviewInjection.cshtml
msgctxt "PV.LivePreview.Views.LivePreviewInjection"
msgid "Live preview is open in a separate window."
msgstr "Živý náhled je otevřený v samostatném okně."

#: PV.LivePreview\Views\LivePreviewInjection.cshtml
msgctxt "PV.LivePreview.Views.LivePreviewInjection"
msgid "Show window"
msgstr "Zobrazit okno"

#: PV.LivePreview\Views\LivePreviewInjection.cshtml
msgctxt "PV.LivePreview.Views.LivePreviewInjection"
msgid "Return to panel"
msgstr "Vrátit do panelu"

#: PV.LivePreview\Views\LivePreviewInjection.cshtml
msgctxt "PV.LivePreview.Views.LivePreviewInjection"
msgid "The browser blocked the new window. Allow pop-up windows for this site."
msgstr "Prohlížeč nové okno zablokoval. Povolte pro tento web vyskakovací okna."

#: PV.LivePreview\Views\LivePreviewInjection.cshtml
msgctxt "PV.LivePreview.Views.LivePreviewInjection"
msgid "Separate window – opens the preview in its own window, for example on a second monitor. The viewport is the size of the window, the form gets the full width. Closing the window returns the preview to the panel."
msgstr "Samostatné okno – otevře náhled ve vlastním okně, např. na druhém monitoru. Viewport má velikost okna a formulář dostane celou šířku. Zavřením okna se náhled vrátí do panelu."

#: PV.LivePreview\Views\LivePreviewInjection.cshtml
msgctxt "PV.LivePreview.Views.LivePreviewInjection"
msgid "Separate window: open / return to the panel"
msgstr "Samostatné okno: otevřít / vrátit do panelu"

#: PV.LivePreview\Views\LivePreview\Window.cshtml
msgctxt "PV.LivePreview.Views.LivePreview.Window"
msgid "Live Preview"
msgstr "Živý náhled"

#: PV.LivePreview\Views\LivePreview\Window.cshtml
msgctxt "PV.LivePreview.Views.LivePreview.Window"
msgid "Connecting to the content editor…"
msgstr "Připojování k editoru obsahu…"

#: PV.LivePreview\Views\LivePreview\Window.cshtml
msgctxt "PV.LivePreview.Views.LivePreview.Window"
msgid "This window works only when it is opened from the content editor (the Open in a separate window button in the live preview toolbar)."
msgstr "Toto okno funguje jen po otevření z editoru obsahu (tlačítko Otevřít v samostatném okně v toolbaru živého náhledu)."

#: PV.LivePreview\Views\LivePreviewInjection.cshtml
msgctxt "PV.LivePreview.Views.LivePreviewInjection"
msgid "Visit the author’s website"
msgstr "Navštívit web autora"
